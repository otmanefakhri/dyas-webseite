{
  "name": "dyas-webseite",
  "version": "1.0.0",
  "private": true,
  "description": "DYAS-Webseite mit Playwright-E2E-Tests",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "python3 -m http.server 8000 --bind 127.0.0.1",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:headed": "playwright test --headed",
    "e2e:report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "22.20.6",
    "typescript": "5.9.3"
  }
}
